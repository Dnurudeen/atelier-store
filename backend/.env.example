APP_NAME="Atelier Nigeria"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Production:
# APP_URL=https://atelier.johnsonluxurystay.com

FRONTEND_URL=http://localhost:3000
# Production:
# FRONTEND_URL=https://atelier-store-phi.vercel.app

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local default: log (emails written to storage/logs). For real mail set smtp.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
# Shown in the branded email signature / support link
MAIL_SUPPORT_ADDRESS="${MAIL_FROM_ADDRESS}"
# Production SMTP example:
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM_ADDRESS=hello@yourdomain.com
# MAIL_SUPPORT_ADDRESS=hello@yourdomain.com
#
# Email templates load the logo from {APP_URL}/brand/logo-header-hd.png
# Keep APP_URL and FRONTEND_URL correct so logo + buttons work in inboxes.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Paste from Paystack Dashboard (test keys first)
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Webhook URL: {APP_URL}/api/v1/webhooks/paystack

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID on the frontend
GOOGLE_CLIENT_ID=

