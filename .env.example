# Frontend (Next.js) — copy to .env.local for local development
# Production: set these in the Vercel project settings

# Laravel API base including /api/v1
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
# Production (Vercel):
# NEXT_PUBLIC_API_URL=https://atelier.johnsonluxurystay.com/api/v1

# Keep false for live API. true falls back to demo catalog/dashboard data.
NEXT_PUBLIC_USE_DEMO=false

# Optional: Paystack public key if you add inline JS later.
# Backend redirect checkout works with backend PAYSTACK_* alone.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Google Sign-In Web client ID (same as backend GOOGLE_CLIENT_ID)
# Authorized JavaScript origins must include localhost and your Vercel URL.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
